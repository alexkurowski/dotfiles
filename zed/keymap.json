// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "cmd-m": "editor::ToggleMinimap",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "use_key_equivalents": true,
    "bindings": {
      "l": "project_panel::OpenPermanent",
      "L": "project_panel::OpenSplitVertical",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-h": "editor::MoveLeft",
      "ctrl-j": "editor::MoveDown",
      "ctrl-k": "editor::MoveUp",
      "ctrl-l": "editor::MoveRight",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "tab": "workspace::Save",
      "H": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": true, "stop_at_indent": true },
      ],
      "J": "editor::MoveToEndOfExcerpt",
      "K": "editor::MoveToStartOfExcerpt",
      "L": "editor::MoveToEndOfLine",
      "ctrl-w h": "pane::SplitLeft",
      "ctrl-w j": "pane::SplitDown",
      "ctrl-w k": "pane::SplitUp",
      "ctrl-w l": "pane::SplitRight",
      "space w": "pane::SplitRight",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space h": "workspace::ActivatePaneLeft",
      "space j": "workspace::ActivatePaneDown",
      "space k": "workspace::ActivatePaneUp",
      "space l": "workspace::ActivatePaneRight",
      "ctrl-o": "project_panel::ToggleFocus",
      "U": "vim::Redo",
      "space f": "editor::Format",
      "backspace": "pane::ActivatePreviousItem",
      "space q": "pane::CloseActiveItem",
    },
  },
]
